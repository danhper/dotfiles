#!/bin/sh

is_dark_theme() {
    case "$(uname -s)" in
        Darwin)
            [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ]
            ;;
        Linux)
            [ "$(cat "$HOME/.cache/theme" 2>/dev/null)" != light ]
            ;;
        *)
            return 1
            ;;
    esac
}

is_dark_theme
