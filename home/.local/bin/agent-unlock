#!/bin/sh
# Unlock the signing key without changing the SSH auth agent.
usage() {
    echo "Usage: agent-unlock [--no-timeout]"
    echo "Default: unlock for ten hours. --no-timeout: unlock until removed or the agent exits."
}

lifetime=10h
case "$#:$1" in
    0:) ;;
    1:--no-timeout) lifetime=0 ;;
    1:--help|1:-h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac

exec "$HOME/.local/bin/ssh-signing-env" ssh-add -t "$lifetime" "$HOME/.ssh/agent_signing"
